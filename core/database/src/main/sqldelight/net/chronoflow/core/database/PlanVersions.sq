CREATE TABLE plan_versions (
    trip_id TEXT NOT NULL REFERENCES trips(id) ON DELETE CASCADE, input_hash TEXT NOT NULL,
    detail TEXT NOT NULL, received_at TEXT NOT NULL, detail_version TEXT,
    PRIMARY KEY (trip_id, input_hash)
);

selectPlanVersion:
SELECT * FROM plan_versions WHERE trip_id = ? AND input_hash = ?;

selectPlanVersionsOfTrip:
SELECT * FROM plan_versions WHERE trip_id = ?;

updatePlanVersion:
UPDATE plan_versions SET detail = ?, received_at = ?, detail_version = ? WHERE trip_id = ? AND input_hash = ?;

insertPlanVersion:
INSERT INTO plan_versions (trip_id, input_hash, detail, received_at, detail_version) VALUES (?, ?, ?, ?, ?);

deletePlanVersionsOfTrip:
DELETE FROM plan_versions WHERE trip_id = ?;

clearDetailVersionsOfTrip:
UPDATE plan_versions SET detail_version = NULL WHERE trip_id = ?;

clearDetailVersionIfDifferent:
UPDATE plan_versions SET detail_version = NULL WHERE trip_id = ? AND input_hash = ? AND detail_version != ?;

selectCurrentPlanVersions:
SELECT p.trip_id, p.detail_version FROM plan_versions p
JOIN trips t ON t.id = p.trip_id AND t.current_input_hash = p.input_hash;
