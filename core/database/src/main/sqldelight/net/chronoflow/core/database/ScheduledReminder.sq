CREATE TABLE scheduled_reminder (
  identifier TEXT PRIMARY KEY NOT NULL,
  request_code INTEGER NOT NULL UNIQUE,
  send_at INTEGER NOT NULL,
  expires_at INTEGER NOT NULL,
  title TEXT NOT NULL,
  body TEXT NOT NULL,
  trip_id TEXT NOT NULL,
  block_id TEXT NOT NULL,
  input_hash TEXT NOT NULL,
  member_keys TEXT NOT NULL,
  account_id TEXT
);

selectScheduledReminders:
SELECT * FROM scheduled_reminder ORDER BY send_at, identifier;

updateScheduledReminder:
UPDATE scheduled_reminder SET request_code = ?, send_at = ?, expires_at = ?, title = ?, body = ?,
  trip_id = ?, block_id = ?, input_hash = ?, member_keys = ?, account_id = ? WHERE identifier = ?;

insertScheduledReminder:
INSERT INTO scheduled_reminder(identifier, request_code, send_at, expires_at, title, body,
  trip_id, block_id, input_hash, member_keys, account_id) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteScheduledReminder:
DELETE FROM scheduled_reminder WHERE identifier = ?;

deleteScheduledReminders:
DELETE FROM scheduled_reminder;
